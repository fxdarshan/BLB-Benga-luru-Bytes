# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM ranks the results: groq (the default) or anthropic.
LLM_PROVIDER=groq

# The API key for the chosen provider. Only that provider's key is needed.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# LLM settings. Leave LLM_MODEL empty to use the provider's default:
# openai/gpt-oss-120b for Groq, or claude-opus-5-5 for Anthropic.
LLM_MODEL=
# Low effort keeps Groq's reasoning short, which saves tokens.
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=45

# Number of candidates sent to the LLM, and recommendations shown. Fewer candidates means
# fewer tokens per search, which matters with Groq's free-plan limits.
MAX_CANDIDATES=8
MAX_RESULTS=5

# Location of generated data files. Relative paths start from the project root.
DATA_DIR=./data

# ---------- HTTP API only (recommender.api) ----------
# Web pages allowed to call the API, comma-separated, such as https://blb.vercel.app.
ALLOWED_ORIGINS=http://localhost:5173
# Optional pattern for more origins, such as Vercel preview URLs:
# https://blb-[a-z0-9-]+-yourteam\.vercel\.app
ALLOWED_ORIGIN_REGEX=
# Searches each client may make per minute. 0 turns the limit off.
RATE_LIMIT_PER_MINUTE=10
# Proxies in front of the API that add to X-Forwarded-For: 1 on Railway, 0 locally.
TRUSTED_PROXY_HOPS=0

# Optional: areas whose default search is kept cached, comma-separated. Each costs about one
# AI search an hour, so name only a few on a free plan. Empty turns it off.
WARM_CACHE_AREAS=
WARM_CACHE_INTERVAL_SECONDS=60

# Where usage counts and feedback are kept (a SQLite file), so they survive restarts. Empty keeps
# them in memory. The Docker image sets /app/state, which on Railway is a mounted volume.
STATE_DIR=

# Tried once when the main Groq model hits its per-minute limit. Empty uses openai/gpt-oss-20b;
# none turns it off.
LLM_FALLBACK_MODEL=
# AI tokens allowed per UTC day before results are ranked by score until midnight. 0 = no cap.
LLM_DAILY_TOKEN_LIMIT=0
