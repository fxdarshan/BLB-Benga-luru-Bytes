# Copy this file to .env and fill in your own values. Never commit .env.

# Claude API key. Not needed for ingestion, and first used in Phase 4.
ANTHROPIC_API_KEY=

# LLM settings
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=45

# Number of candidates sent to the LLM, and recommendations shown
MAX_CANDIDATES=15
MAX_RESULTS=5

# Location of generated data files. Relative paths start from the project root.
DATA_DIR=./data
