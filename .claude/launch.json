{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "design"
      ],
      "port": 8765
    },
    {
      "name": "blb-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-default-groups",
        "uvicorn",
        "--factory",
        "recommender.api:create_app",
        "--port",
        "8000"
      ],
      "env": {
        "ALLOWED_ORIGINS": "http://localhost:5173"
      },
      "port": 8000
    },
    {
      "name": "blb-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
