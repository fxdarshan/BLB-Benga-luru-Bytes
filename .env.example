# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM ranks the results: groq (the default) or anthropic.
LLM_PROVIDER=groq

# The API key for the chosen provider. Only that provider's key is needed.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# LLM settings. Leave LLM_MODEL empty to use the provider's default:
# openai/gpt-oss-120b for Groq, or claude-opus-5-5 for Anthropic.
LLM_MODEL=
# Low effort keeps Groq's reasoning short, which saves tokens.
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=45

# Number of candidates sent to the LLM, and recommendations shown. Fewer candidates means
# fewer tokens per search, which matters with Groq's free-plan limits.
MAX_CANDIDATES=8
MAX_RESULTS=5

# Location of generated data files. Relative paths start from the project root.
DATA_DIR=./data
